# OPENAI_MODEL=gpt-4o-mini
VENDOR_AWS_BILLING_CREDENTIALS={"access_key_id":"","secret_access_key":"","region":"us-east-1"}
VENDOR_BILL_CREDENTIALS={"userName":"","password":"","orgId":"008...","devKey":"","baseUrl":"https://gateway.prod.bill.com/connect"}
VENDOR_GCP_BILLING_CREDENTIALS={"type":"service_account","project_id":"","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
VENDOR_QBO_CREDENTIALS={"client_id":"","client_secret":"","realm_id":"","refresh_token":""}
QBO_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
PUBLIC_BASE_URL=http://localhost:8000

# Payload CMS REST API. The URL must include any base-path prefix the
# CMS is mounted at — locally Payload runs at http://localhost:3000/cms/api/**
# (basePath in haderach-cms/next.config.ts). cms_tools.py constructs request
# URLs as `${CMS_API_URL}/api/...`, so do NOT include the `/api` suffix here.
# Prod (when wired): https://haderach.ai/cms
CMS_API_URL=http://localhost:3000/cms
CMS_API_KEY=cms-api-key.txt
